<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hubuddy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.Hubuddy.Dialog</item>
    </style>
    <style name="Theme.Hubuddy.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:background">@color/surface</item>
    </style>
    <style name="Theme.Hubuddy.DialogLight" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#0B8379</item>
    </style>
</resources>
