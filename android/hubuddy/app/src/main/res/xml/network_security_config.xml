<?xml version="1.0" encoding="utf-8"?>
<!-- Everything leaves the phone over HTTPS. PCs are reached by a pinned private identity (see PinnedTls), so nothing
     here depends on the phone's list of trusted authorities, and plain HTTP is not allowed anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
